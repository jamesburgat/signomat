[Unit]
Description=Signomat Pi Runtime
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
User=jamesburgat
Group=jamesburgat
WorkingDirectory=/home/jamesburgat/signomat
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=50
IOWeight=50
Environment=HOME=/home/jamesburgat
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/jamesburgat/signomat/pi/src
EnvironmentFile=-/etc/default/signomat
ExecStart=/home/jamesburgat/signomat/.venv/bin/python -m signomat_pi.cli.main --config /home/jamesburgat/signomat/pi/config/default.yaml serve
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

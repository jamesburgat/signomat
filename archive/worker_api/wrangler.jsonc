{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signomat-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-30",
  "routes": [
    {
      "pattern": "signs.jamesburgat.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../frontend",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/health",
      "/config-check",
      "/ingest/*",
      "/public/*",
      "/admin/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "ARCHIVE_DB",
      "database_name": "signomat-archive",
      "database_id": "9c4fa20d-390e-4cb3-9878-0d0e0a79578e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "signomat-media"
    },
    {
      "binding": "THUMBS_BUCKET",
      "bucket_name": "signomat-thumbs"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://signs.jamesburgat.com"
  }
}

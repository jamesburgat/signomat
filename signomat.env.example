# Signomat runtime defaults now live in `pi/config/default.yaml`.
# Keep this file for deployment-specific values and secrets only.

# Cloudflare sync target.
# SIGNOMAT_SYNC_BASE_URL=https://signomat-api.<your-subdomain>.workers.dev
# SIGNOMAT_INGEST_TOKEN=replace-with-your-worker-secret

# Optional machine-local overrides.
# SIGNOMAT_LOG_LEVEL=INFO
# SIGNOMAT_SYNC_REQUEST_TIMEOUT_SECONDS=15
# SIGNOMAT_SYNC_MAX_MEDIA_UPLOAD_MB=95
# SIGNOMAT_PREVIEW_MAX_WIDTH=960
# SIGNOMAT_PREVIEW_JPEG_QUALITY=70

# The app no longer applies manual exposure / gain tuning from env vars.
